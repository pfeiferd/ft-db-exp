<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>org.metagene</groupId>
	<artifactId>ft-db-exp</artifactId>
	<version>1.6</version>


	<properties>
		<genestrip.version>3.0</genestrip.version>
		<gs.project.name>${name}</gs.project.name>
		<gs.project.goal>${goal}</gs.project.goal>
		<gs.project.fqmap>${fqmap}</gs.project.fqmap>
		<gs.project.fqfile>${fqfile}</gs.project.fqfile>
		<gs.project.reportkey>${reportkey}</gs.project.reportkey>
		<gs.project.simulator>${simulator}</gs.project.simulator>
		<!-- Report key of the simulated run whose rho_{d,s} calibrates a `specificity' run;
		     empty leaves the estimate columns of the CSV blank. -->
		<gs.project.calibration></gs.project.calibration>
		<!-- Heap for the database goals. The original experiments used a 64 GB machine;
		     override on a smaller one, e.g. -Dgs.xmx=10G . -->
		<gs.xmx>64G</gs.xmx>
		<!-- Worker threads for the Genestrip goals. A negative value means one thread per
		     available processor less one, which is Genestrip's own default. The classification
		     experiments use exactly that, since AccuracyEvaluator sets it in code and the
		     `accuracy' execution below takes no thread option, so keeping it here means every
		     experiment of the paper runs with the same thread count. Pin it to reproduce a
		     specific run, e.g. -Dgs.threads=19 . -->
		<gs.threads>-1</gs.threads>
		<!-- The typing that the `stquality' execution measures against, and which of the two
		     database variants to measure. Defaulted so that -Dname=cdiff alone does the usual
		     thing; override with -Dgs.st.csv=... / -Dgs.st.which=db|ftdb . -->
		<gs.st.csv>results/${name}_mlst.csv</gs.st.csv>
		<gs.st.which>both</gs.st.which>
		<!-- Generation target of the `match' execution. The performance measurement sets
		     -Dgs.target=clean once beforehand, so that the goal really runs instead of
		     finding its result files already in place and reporting a runtime of zero. -->
		<gs.target>make</gs.target>
	</properties>
	
	<name>genestrip-db-exp</name>
	<description>A selection of databases for Genestrip</description>
	<url>https://github.com/pfeiferd/genestrip-db-exp</url>
	<inceptionYear>2024</inceptionYear>

	<organization>
		<name>Progotec</name>
		<url>http://www.progotec.de</url>
	</organization>

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>https://raw.githubusercontent.com/pfeiferd/genestrip-db-exp/master/LICENSE.txt</url>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:git://github.com/pfeiferd/genestrip-db-exp.git</connection>
		<developerConnection>scm:git:ssh://github.com/pfeiferd/genestrip-db-exp.git</developerConnection>
		<url>https://github.com/pfeiferd/genestrip-db-exp/tree/master</url>
	</scm>
	
	<developers>
		<developer>
			<name>Daniel Pfeifer</name>
			<email>daniel.pfeifer@progotec.de</email>
		</developer>
	</developers>
	<dependencies>
		<dependency>
			<groupId>org.genestrip</groupId>
			<artifactId>base</artifactId>
			<version>${genestrip.version}</version>
		</dependency>
		<dependency>
			<groupId>org.genestrip</groupId>
			<artifactId>core</artifactId>
			<version>${genestrip.version}</version>
		</dependency>
		<dependency>
			<groupId>org.genestrip</groupId>
			<artifactId>ft</artifactId>
			<version>${genestrip.version}</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.0</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>cleanall</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.genestrip.finertree.FinerTreeMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.project.goal}</argument>
								<argument>-t</argument>
								<argument>cleanall</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>db</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx${gs.xmx}</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.genestrip.finertree.FinerTreeMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.project.goal}</argument>
								<!-- `make' unless asked otherwise. A goal whose *inputs* changed without its
								     output file changing - a different `clusterMethod', say - is not noticed
								     by the make system, so dropping the stale file is the only way to have it
								     rebuilt. Mind which target does what, and check the chain before using one:
								     `clean' aggregates the request into an internal goal and cleans only that,
								     so it never touches a real goal at all. `cleanall <goal>' drops that goal's
								     output and then descends into every dependency whose key permits transitive
								     cleaning - and `db' does, so `cleanall dbinfo' DELETES THE DATABASE and the
								     next make rebuilds it from the genomes. `cleantotal' cleans everything
								     reachable, unconditionally. Deleting the one output file by hand is the
								     predictable way to force a single goal to run again. -->
								<argument>-t</argument>
								<argument>${gs.target}</argument>
								<argument>-C</argument>
								<argument>threads=${gs.threads}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<!-- Intrinsic database quality at the sequence type level, for a database
						     refined below the species rank. It needs an external typing of the
						     genomes, which is what `stcsv' points at; bin/cdiff_eval.sh produces it.
						     Both database variants are measured unless `stwhich' says otherwise. -->
						<id>stquality</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx${gs.xmx}</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.ftdbexp.stquality.STQualityMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.st.csv}</argument>
								<argument>${gs.st.which}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<!-- Plain read classification against one database variant, used to measure
						     classification performance. Kept apart from `accuracy', which runs both
						     variants in one JVM and scores every read against its ground truth on
						     top - neither of which belongs in a classification timing. -->
						<id>match</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx${gs.xmx}</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.genestrip.finertree.FinerTreeMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.project.goal}</argument>
								<argument>-t</argument>
								<argument>${gs.target}</argument>
								<argument>-m</argument>
								<argument>${gs.project.fqmap}</argument>
								<argument>-C</argument>
								<argument>threads=${gs.threads}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<!-- Downloads the fastq input files a map declares by URL, through Genestrip's
						     own goal `fastqdownload'. -ll stores them in the common fastq directory
						     (data/fastq) rather than per project, named after their key in the map,
						     so several projects share one copy. Genestrip skips whatever is already
						     in place, which is why this needs no download script of its own. Note that
						     a fastq map has no checksum column (that exists only on the genome side, in
						     common/fasta/downloads.txt), so nothing verifies the content here;
						     make_fastqs.sh runs gzip -t over the result for that reason. A download
						     needs no heap to speak of, hence the small -Xmx. -->
						<id>fastqdl</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx2G</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.genestrip.finertree.FinerTreeMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>fastqdownload</argument>
								<argument>-ll</argument>
								<argument>-m</argument>
								<argument>${gs.project.fqmap}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>accuracy</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx${gs.xmx}</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.ftdbexp.FTExpMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.project.fqmap}</argument>
								<argument>${gs.project.reportkey}</argument>
								<argument>${gs.project.simulator}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<!-- The ground-truth-free measurement on real reads: no precision, no recall,
						     only how far each database variant narrows the species down. -->
						<id>specificity</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx${gs.xmx}</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.ftdbexp.FTSpecificityMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.project.fqmap}</argument>
								<argument>${gs.project.reportkey}</argument>
								<argument>${gs.project.calibration}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>nanosimlist</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx8G</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.ftdbexp.nanosim.NanoSimGenomeList</argument>
								<argument>${gs.project.name}</argument>
							</arguments>
						</configuration>
					</execution>
					<execution>
						<id>orthopox3</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>java</executable>
							<includeProjectDependencies>true</includeProjectDependencies>
							<includePluginDependencies>true</includePluginDependencies>
							<arguments>
								<argument>-Xmx${gs.xmx}</argument>
								<argument>-classpath</argument>
								<classpath />
								<argument>org.metagene.genestrip.finertree.FinerTreeMain</argument>
								<argument>${gs.project.name}</argument>
								<argument>${gs.project.goal}</argument>
								<argument>-C</argument>
								<argument>threads=${gs.threads}</argument>
								<argument>-C</argument>
								<argument>svgDistanceIndent=true</argument>
								<argument>-C</argument>
								<argument>svgMarkLongestPath=true</argument>
								<argument>-C</argument>
								<argument>svgShowDistancePortion=true</argument>
								<argument>-C</argument>
								<argument>svgShowDistance=true</argument>
								<argument>-C</argument>
								<argument>svgKmerNodeIndentFactor=1000</argument>
								<argument>-C</argument>
								<argument>svgTooLargeDistance=0.8</argument>
								<argument>-C</argument>
								<argument>svgDistanceIndentBelowRank=acellular root</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>